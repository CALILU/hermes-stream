{
  "manifest_version": 3,
  "name": "IsiPrime Downloader",
  "version": "1.2",
  "description": "Añade videos de OK.ru a la cola de descargas de IsiPrime",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:9876/*", "https://ok.ru/*", "https://*.ok.ru/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
